      <TargetMachinePlatform>64</TargetMachinePlatform>
      <CompileOut>$(IntDir)%(Filename)%(Extension).obj</CompileOut>
      <KeepDir>$(IntDir)</KeepDir>
      <CodeGeneration>$(CUDA_ARCH)</CodeGeneration>
      <Optimization>O3</Optimization>
