  <PropertyGroup Label="ThirdPartyPaths">
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    <OPENCV_ROOT Condition="'$(OPENCV_ROOT)'==''">D:\Compile\OpenCV-4.11.0\build\install</OPENCV_ROOT>
